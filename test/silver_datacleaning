-- Data cleaning :
-- Check duplicate column: 
SELECT *, ROW_NUMBER() OVER(PARTITION BY ORDERNUMBER ORDER BY ORDERDATE) AS dup_flag
FROM bronze.salesdata;

-- 
SELECT *
FROM bronze.salesdata
WHERE QUANTITYORDERED < 0 OR QUANTITYORDERED IS NULL;

--
SELECT *
FROM bronze.salesdata
WHERE PRICEEACH  < 0 OR PRICEEACH  IS NULL;

--
SELECT *
FROM bronze.salesdata
WHERE ORDERLINENUMBER < 0 OR ORDERLINENUMBER IS NULL;

--
SELECT 
SALES, PRICEEACH, QUANTITYORDERED
FROM bronze.salesdata
WHERE SALES < 0 OR SALES IS NULL OR SALES != PRICEEACH  * QUANTITYORDERED;

--
SELECT 
	MIN(ORDERDATE),
	MAX(ORDERDATE),
	DATEDIFF(MONTH,MIN(ORDERDATE),MAX(ORDERDATE)) ,
	DATEDIFF(YEAR,MIN(ORDERDATE),MAX(ORDERDATE))
FROM bronze.salesdata

SELECT *
FROM bronze.salesdata
WHERE ORDERDATE IS NULL OR ORDERDATE = GETDATE()

