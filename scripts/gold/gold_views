-- Business data view: dim_product, dim_customer and fact_orders
-- View gold.dim_customer
CREATE VIEW gold.dim_customer AS
WITH dim_customer AS(
SELECT *, 
ROW_NUMBER() OVER(ORDER BY customer_name) AS customer_id
FROM(
SELECT DISTINCT 
    customer_name,     
    postal_code,
    address1 AS address,
    city,
    country,
    territory
FROM silver.salesdata) AS customer_data)
SELECT 
    customer_id,
    customer_name,     
    postal_code,
    address,
    city,
    country,
    territory
FROM dim_customer ;

-- View gold.dim_product
CREATE View gold.dim_product AS
WITH dim_product AS(
SELECT *, 
ROW_NUMBER() OVER(ORDER BY product_code) AS product_id
FROM(
SELECT DISTINCT 
    product_code,
    product_line,
    manufacturer_price
FROM silver.salesdata) AS product)
SELECT 
    product_id,
    product_code,
    product_line,
    manufacturer_price
FROM dim_product

-- View fact_sales
CREATE VIEW fact_sales AS
SELECT 
    s.order_number,
    p.product_id,   
    c.customer_id, 
    s.orderline_number,
    s.deal_size,
    s.quantity ,
    s.price ,
    s.sales_amount,
    s.order_date
FROM silver.salesdata s
LEFT JOIN gold.dim_product p ON s.product_code = p.product_code
LEFT JOIN gold.dim_customer c ON s.customer_name = c.customer_name






