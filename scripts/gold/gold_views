-- Business data view
CREATE VIEW business_data AS
SELECT order_number
      ,quantity
      ,price
      ,orderline_number
      ,sales_amount
      ,order_date
      ,status
      ,product_line
      ,manufacturer_price
      ,product_code
      ,customer_name
      ,phone_number
      ,address1 AS address
      ,city
      ,postal_code
      ,country
      ,territory
      ,conatact_lastname
      ,contact_name
      ,deal_size
FROM silver.salesdata

